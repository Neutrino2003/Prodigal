# NVIDIA NIM API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Payment API Configuration (Prodigal assignment endpoint)
PAYMENT_API_BASE_URL=https://payments.internal.prodigal.ai

# Verification Settings
MAX_VERIFICATION_ATTEMPTS=3

# LLM Model Configuration
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Request Timeout (seconds)
REQUEST_TIMEOUT_SECONDS=10
PAYMENT_TIMEOUT_SECONDS=15
LOOKUP_NETWORK_RETRIES=1
